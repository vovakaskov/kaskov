def caesar_shift(s: str, n: int) -> str:
    result = []
    for ch in s:
        if 'a' <= ch <= 'z':
            result.append(chr((ord(ch) - ord('a') + n) % 26 + ord('a')))
        elif 'A' <= ch <= 'Z':
            result.append(chr((ord(ch) - ord('A') + n) % 26 + ord('A')))
        else:
            result.append(ch)
    return ''.join(result)   # join из раздела «Разделение и объединение»
